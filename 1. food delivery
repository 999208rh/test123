<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>🥙 Система доставки еды</title>
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-gradient bg-success bg-opacity-50 min-vh-100 p-4">

<div class="container max-w-xxl mx-auto bg-white rounded-3 shadow-lg p-4">
  <!-- Шапка -->
  <div class="bg-success text-white p-4 rounded-top text-center mb-3">
    <h1 class="display-4 mb-2">🥙 Система доставки еды</h1>
    <p class="opacity-75">Управление заказами и доставкой</p>
  </div>

  <!-- Основная часть -->
  <div class="row g-3">
    <!-- Форма ввода -->
    <div class="col-12">
      <div class="border rounded-3 p-3 bg-light d-flex flex-wrap gap-3">
        <div class="flex-fill">
          <label class="form-label mb-1" for="orderId">ID Заказа</label>
          <input type="text" id="orderId" class="form-control" placeholder="Введите ID заказа">
        </div>
        <div class="flex-fill">
          <label class="form-label mb-1" for="customerName">Имя клиента</label>
          <input type="text" id="customerName" class="form-control" placeholder="Введите имя">
        </div>
        <div class="flex-fill">
          <label class="form-label mb-1" for="foodSelect">Блюдо</label>
          <select id="foodSelect" class="form-select"></select>
        </div>
        <div class="flex-fill">
          <label class="form-label mb-1" for="quantity">Количество</label>
          <input type="number" id="quantity" class="form-control" placeholder="Кол-во">
        </div>
        <div class="flex-fill">
          <label class="form-label mb-1" for="address">Адрес</label>
          <input type="text" id="address" class="form-control" placeholder="Адрес доставки">
        </div>
        <div class="flex-fill">
          <label class="form-label mb-1" for="deliveryBoy">Курьер</label>
          <input type="text" id="deliveryBoy" class="form-control" placeholder="Имя курьера">
        </div>
      </div>
    </div>

    <!-- Кнопки -->
    <div class="col-12 d-flex flex-wrap gap-2 mt-3">
      <button id="addBtn" class="btn btn-success flex-fill">➕ Добавить заказ</button>
      <button id="showAllBtn" class="btn btn-primary flex-fill">📄 Показать все</button>
      <button id="searchByIdBtn" class="btn btn-purple flex-fill text-white" style="background-color: purple;">🔍 Найти по ID</button>
      <button id="deleteBtn" class="btn btn-danger flex-fill">🗑️ Удалить выбранное</button>
    </div>

    <!-- Таблица заказов -->
    <div class="col-12 mt-4 table-responsive">
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
          <tr>
            <th scope="col">ID Заказа</th>
            <th scope="col">Клиент</th>
            <th scope="col">Блюдо</th>
            <th scope="col">Кол-во</th>
            <th scope="col">Адрес</th>
            <th scope="col">Курьер</th>
            <th scope="col" class="text-center">Выбор</th>
          </tr>
        </thead>
        <tbody id="tableBody"></tbody>
      </table>
    </div>

    <!-- Итог -->
    <div class="col-12 d-flex justify-content-between align-items-center mt-3">
      <div class="fs-4 fw-semibold text-secondary" id="totalOrders">Всего заказов: 0</div>
    </div>
  </div>
</div>

<script>
  const orders = [];

  // Продукты с ценами
  const menuProducts = [
    { name: "Burger", price: 10 },
    { name: "Pizza", price: 15 },
    { name: "Sushi", price: 20 },
    { name: "Pasta", price: 12 },
    { name: "Salad", price: 8 },
    { name: "Soup", price: 7 }
  ];

  // Элементы
  const orderIdInput = document.getElementById('orderId');
  const customerInput = document.getElementById('customerName');
  const foodSelect = document.getElementById('foodSelect');
  const quantityInput = document.getElementById('quantity');
  const addressInput = document.getElementById('address');
  const deliveryInput = document.getElementById('deliveryBoy');

  const tableBody = document.getElementById('tableBody');
  const totalOrders = document.getElementById('totalOrders');

  const addBtn = document.getElementById('addBtn');
  const showAllBtn = document.getElementById('showAllBtn');
  const searchByIdBtn = document.getElementById('searchByIdBtn');
  const deleteBtn = document.getElementById('deleteBtn');

  // Заполняем селект продуктами
  menuProducts.forEach(product => {
    const option = document.createElement('option');
    option.value = product.name;
    option.innerText = `${product.name} ($${product.price})`;
    foodSelect.appendChild(option);
  });

  function updateOrderCount() {
    totalOrders.innerText = `Всего заказов: ${orders.length}`;
  }

  function renderTable(filteredOrders = null) {
    tableBody.innerHTML = '';
    const list = filteredOrders || orders;
    list.forEach(order => {
      const row = document.createElement('tr');

      const product = menuProducts.find(p => p.name === order.foodItem);
      const price = product ? product.price : 0;
      const totalPrice = price * order.quantity;

      // Проверка суммы заказа
      let customerDisplayName = order.customerName;
      if (totalPrice > 100) {
        customerDisplayName += ' ☆ '; // Добавляем звездочку
      }

      // Создаем ячейку клиента с подсветкой, если сумма > 100
      const tdCustomer = document.createElement('td');
      tdCustomer.className = (totalPrice > 100) ? 'bg-warning' : '';
      tdCustomer.innerText = customerDisplayName;

      row.innerHTML = `
        <td class="border px-3 py-2">${order.orderId}</td>
        ${tdCustomer.outerHTML}
        <td class="border px-3 py-2">${order.foodItem} ($${price})</td>
        <td class="border px-3 py-2">${order.quantity}</td>
        <td class="border px-3 py-2">${order.address}</td>
        <td class="border px-3 py-2">${order.deliveryBoy}</td>
        <td class="border px-3 py-2 text-center"><input type="checkbox" class="form-check-input selectCheckbox"></td>
      `;
      tableBody.appendChild(row);
    });
  }

  document.getElementById('addBtn').addEventListener('click', () => {
    const id = document.getElementById('orderId').value.trim();
    const cust = document.getElementById('customerName').value.trim();
    const food = document.getElementById('foodSelect').value;
    const qty = parseInt(document.getElementById('quantity').value.trim());
    const addr = document.getElementById('address').value.trim();
    const boy = document.getElementById('deliveryBoy').value.trim();

    if (!id || !cust || !food || !qty || !addr || !boy) {
      alert('Пожалуйста, заполните все поля!');
      return;
    }

    const newOrder = { orderId: id, customerName: cust, foodItem: food, quantity: qty, address: addr, deliveryBoy: boy };
    orders.push(newOrder);
    renderTable();
    // Очистка полей
    document.getElementById('orderId').value = '';
    document.getElementById('customerName').value = '';
    document.getElementById('quantity').value = '';
    document.getElementById('address').value = '';
    document.getElementById('deliveryBoy').value = '';
  });

  document.getElementById('showAllBtn').addEventListener('click', () => {
    renderTable();
  });

  // Поиск по ID
  document.getElementById('searchByIdBtn').addEventListener('click', () => {
    const searchId = document.getElementById('orderId').value.trim();
    if (!searchId) {
      alert('Пожалуйста, введите ID заказа для поиска');
      return;
    }
    const foundOrder = orders.find(o => o.orderId === searchId);
    if (foundOrder) {
      renderTable([foundOrder]);
    } else {
      alert('Заказ с таким ID не найден');
      renderTable([]);
    }
  });

  // Удаление выбранных заказов
  document.getElementById('deleteBtn').addEventListener('click', () => {
    const checkboxes = document.querySelectorAll('.selectCheckbox');
    const idsToRemove = [];

    checkboxes.forEach((cb, index) => {
      if (cb.checked) {
        idsToRemove.push(orders[index].orderId);
      }
    });

    for (let i = orders.length - 1; i >= 0; i--) {
      if (idsToRemove.includes(orders[i].orderId)) {
        orders.splice(i, 1);
      }
    }
    renderTable();
    updateOrderCount();
  });


  // Изначальные заказы
  orders.push({ orderId: "F001", customerName: "John", foodItem: "Burger", quantity: 2, address: "123 Main St", deliveryBoy: "Alex" });
  orders.push({ orderId: "F002", customerName: "Emily", foodItem: "Pizza", quantity: 1, address: "456 Elm St", deliveryBoy: "Brian" });
  renderTable();
  updateOrderCount();
</script>
</body>
</html>
